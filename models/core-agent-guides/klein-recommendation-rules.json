  "upscaling": {
    "default": {
      "upscaler": null,
      "scale_factor": 1,
      "reason": "Generate and inspect the base image first; do not assume an upscaler is needed."
    },
    "native_selection_policy": [
      "Use only an exact model name reported by the installed Draw Things upscaler registry.",
      "Do not put an arbitrary Hugging Face repository or filename into the native upscaler field.",
      "If no registry is available, return no native upscaler and optionally recommend a separate post-processing pipeline.",
      "For coloring pages, reject upscaled results with gray fills, broken contours, filled gaps, or excessive line thickening."
    ],
    "external_candidates": [
      {
        "family": "Real-ESRGAN / ESRGAN",
        "use": "optional_external_post_processing",
        "native_cli_compatibility": "not_assumed",
        "validation": [
          "compare edges at print size",
          "check for halos",
          "check texture hallucination",
          "verify output dimensions"
        ]
      }
    ],
    "scale_policy": {
      "default_scale_factor": 1,
      "allow_2x_when_needed": true,
      "avoid_upscaling_if": [
        "base image has composition errors",
        "line art contains open contours",
        "text or labels are malformed",
        "anatomy is visibly incorrect"
      ]
    }
  },
  "prompt_engine": {
    "negative_prompt_mode": "unsupported",
    "strategy": [
      "Specify desired visual properties directly rather than listing only undesired properties.",
      "Use exact subject counts when important.",
      "Describe subject/action, age/use, medium/style, composition, lighting/palette, background, and technical requirements in that order.",
      "Express exclusions as positive target states, e.g. 'pure white background', 'no lettering', 'large enclosed regions', 'generous margins'. These are probabilistic instructions, not guaranteed filters.",
      "For informative nonfiction, generate the illustration separately from labels and add typography in layout software.",
      "For series consistency, reuse a canonical character description, palette, wardrobe, style profile, and seed policy.",
      "Use LoRA trigger tokens exactly as documented and avoid incompatible style stacking.",
      "When output fails, change one variable at a time."
    ],
    "prompt_template": [
      "{style_trigger_if_any}",
      "{subject_and_action}",
      "{audience_and_intended_use}",
      "{medium_and_style}",
      "{composition_and_camera_or_viewpoint}",
      "{lighting_and_palette}",
      "{background_and_whitespace}",
      "{quality_and_structure_requirements}",
      "{positive_exclusions}"
    ],
    "positive_constraint_examples": {
      "line_art": [
        "pure white background",
        "black outlines only",
        "continuous contours",
        "closed coloring regions",
        "uniform line weight",
        "generous white margin"
      ],
      "anatomy": [
        "natural relaxed pose",
        "clearly separated fingers",
        "anatomically plausible proportions"
      ],
      "text_free": [
        "visual storytelling only",
        "no lettering or labels",
        "empty callout spaces for later labels"
      ],
      "clean_background": [
        "uncluttered background",
        "only three supporting objects",
        "clear separation between subject and background"
      ],
      "photorealism": [
        "natural material texture",
        "physically consistent shadows",
        "credible lens perspective",
        "realistic depth of field"
      ]
    }
  },
  "selection_rules": [
    {
      "id": "R01",
      "priority": 100,
      "if": {
        "intent_any": [
          "printable_coloring",
          "line_art",
          "mandala_coloring"
        ]
      },
      "then": {
        "profile_from_intent": true,
        "prefer_no_lora_initially": true,
        "require_white_background": true,
        "require_contour_validation": true,
        "upscale_only_after_validation": true
      }
    },
    {
      "id": "R02",
      "priority": 95,
      "if": {
        "style_any": [
          "anime",
          "manga",
          "2d_anime"
        ]
      },
      "then": {
        "lora_id": "klein_anime_koni",
        "weight": 0.65,
        "require_lora_load_test": true
      }
    },
    {
      "id": "R03",
      "priority": 95,
      "if": {
        "style_any": [
          "pixel_art",
          "retro_pixel_art"
        ]
      },
      "then": {
        "lora_id": "klein_pixel_art",
        "weight": 0.8,
        "test_resolution": [
          512,
          512
        ],
        "require_lora_load_test": true
      }
    },
    {
      "id": "R04",
      "priority": 80,
      "if": {
        "intent_any": [
          "preschool_picture_book",
          "early_reader"
        ]
      },
      "then": {
        "prefer_simple_shapes": true,
        "limit_background_complexity": true,
        "prefer_clear_silhouettes": true
      }
    },
    {
      "id": "R05",
      "priority": 85,
      "if": {
        "intent_any": [
          "educational_nonfiction",
          "informative_book",
          "science_diagram"
        ]
      },
      "then": {
        "prefer_no_lora_initially": true,
        "reserve_label_spaces": true,
        "add_text_after_generation": true,
        "require_fact_check": true
      }
    },
    {
      "id": "R06",
      "priority": 70,
      "if": {
        "intent_any": [
          "watercolor",
          "oil_painting",
          "pencil_sketch",
          "photorealism",
          "3d_render"
        ]
      },
      "then": {
        "prefer_prompt_driven_base_model_first": true,
        "use_medium_specific_prompt": true,
        "prefer_no_lora_initially": true
      }
    },
    {
      "id": "R07",
      "priority": 100,
      "if": {
        "lora_load_test_failed": true
      },
      "then": {
        "remove_lora": true,
        "use_prompt_fallback": true,
        "record_compatibility_failure": true
      }
    },
    {
      "id": "R08",
      "priority": 100,
      "if": {
        "upscaler_registry_unknown": true
      },
      "then": {
        "upscaler": null,
        "scale_factor": 1,
        "recommend_external_upscaling_only_if_needed": true
      }
    },
    {
      "id": "R09",
      "priority": 100,
      "if": {
        "prompt_contains_conflicting_media": true
      },
      "then": {
        "split_into_alternative_profiles": true,
        "examples": [
          [
            "watercolor"
          ],
          [
            "oil painting"
          ],
          [
            "photorealism"
          ],
          [
            "anime"
          ]
        ]
      }
    },
    {
      "id": "R10",
      "priority": 90,
      "if": {
        "series_consistency_required": true
      },
      "then": {
        "freeze_character_bible": true,
        "freeze_palette": true,
        "record_seed": true,
        "record_lora_weights": true,
        "record_model_version": true
      }
    }
  ],
