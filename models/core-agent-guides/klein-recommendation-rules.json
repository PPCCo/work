  "title": "Draw Things CLI FLUX.2 Klein 4B Recommendation Rules",
  "purpose": "Machine-readable starting rules for selecting generation profiles, prompt constraints, candidate LoRAs, samplers, steps, CFG, dimensions, upscaling, and validation for book illustrations and related artwork.",
  "runtime": {
    "cli": "draw-things-cli",
    "model_default": "flux_2_klein_4b_f16.ckpt",
    "negative_prompt_supported": false,
    "config_json_policy": {
      "only_emit_fields_verified_by_installed_cli": true,
      "omit_schedule_sampler_unless_installed_cli_confirms_support": true,
      "upscaler_name_must_match_installed_registry_exactly": true,
      "lora_file_must_be_imported_or_resolvable_by_cli": true,
      "never_rename_file_extension_as_conversion": true
    },
    "compatibility_policy": {
      "require_model_family_match": true,
      "accept_lora_only_after_load_test": true,
      "external_upscaler_is_not_assumed_to_be_native": true,
      "unknown_capability_action": "fall_back_to_base_model_and_no_native_upscaler"
    }
  },
