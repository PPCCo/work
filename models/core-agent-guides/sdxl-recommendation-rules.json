  "loras": {
    "redmondv2_kids_storybook_lora_f16.ckpt": {
      "weight_range": [0.7, 0.9],
      "trigger": ["KidsRedmAF", "Kids Book"],
      "use_for": [
        "children's picture books",
        "gentle narrative vignettes",
        "storybook watercolor/gouache style"
      ],
      "notes": "Use style tokens such as colorful, minimalist, detailed; reduce for adult or realism tasks."
    },
    "redmond_coloringbook_lora_f16.ckpt": {
      "weight_range": [0.85, 1.0],
      "trigger": ["ColoringBookAF", "Coloring Book"],
      "use_for": [
        "printable black-white coloring pages",
        "children's coloring books",
        "adult mandalas",
        "worksheet line art"
      ],
