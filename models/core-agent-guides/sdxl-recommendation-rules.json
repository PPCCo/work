  "decision_rules": [
    {
      "when": "coloring_page or strict_black_white_line_art",
      "use_model": "juggernaut_xl_v9_f16.ckpt",
      "loras": [
        {
          "file": "redmond_coloringbook_lora_f16.ckpt",
          "weight": "0.85-1.0"
        }
      ],
      "sampler": 0,
      "steps": "24-32",
      "cfg": "4.5-5.8",
      "upscaler": "4x_foolhardy_remacri_extrasmoother_f16.ckpt or 4x_ultrasharp_f16.ckpt",
      "positive_constraints": [
        "pure black outlines",
        "pure white background",
        "closed contours",
        "no gray shading",
        "wide margin"
      ],
      "negative_profile": "coloring_book"
    },
    {
      "when": "children_picture_book",
      "use_model": "colorfulxl_v6.0_f16.ckpt or juggernaut_xl_v9_f16.ckpt",
      "loras": [
        {
          "file": "redmondv2_kids_storybook_lora_f16.ckpt",
          "weight": "0.7-0.9"
        }
      ],
      "sampler": 0,
      "steps": "24-30",
