    }
  },
  "upscalers": {
    "4x_foolhardy_remacri_extrasmoother_f16.ckpt": {
      "scale_factor": 4,
      "prefer_for": [
        "children's illustrations",
        "smooth clean linework",
        "soft painterly art"
      ],
      "risk": "may soften small hatch marks or micro-detail"
    },
    "4x_nmkd_superscale_sp_178000_g_f16.ckpt": {
      "scale_factor": 4,
      "prefer_for": [
        "general illustration",
        "mixed textures",
        "painterly scenes"
      ],
      "risk": "may amplify or invent texture"
    },
    "4x_ultrasharp_f16.ckpt": {
      "scale_factor": 4,
      "prefer_for": [
        "crisp digital drawing",
        "bold outlines",
        "graphic illustration"
      ],
      "risk": "halos/oversharpened line edges"
    },
    "realesrgan_x4plus_anime_6b_f16.ckpt": {
      "scale_factor": 4,
      "prefer_for": ["anime", "manga color art", "cel-shaded cartoons"],
      "risk": "oversharpened gradients or joins"
    },
    "realesrgan_x4plus_f16.ckpt": {
      "scale_factor": 4,
      "prefer_for": [
        "photorealism",
        "natural textures",
        "realistic animals/objects"
      ],
      "risk": "crunchy details and altered soft paint"
    },
    "realesrgan_x2plus_f16.ckpt": {
      "scale_factor": 2,
      "prefer_for": [
        "conservative 2x enlargement",
        "sketches",
        "quality proofing"
      ],
      "risk": "less enlargement than 4x"
    }
  },
  "age_profiles": {
    "preschool_3_5": {
      "detail_density": "very_low",
      "main_subject_count": [1, 2],
      "shape_rule": "large silhouette, 1-3 main forms, large closed shapes when line art",
      "avoid": [
        "tiny texture",
        "thin lines",
        "crowded background",
        "subtle contrast"
      ]
    },
    "early_reader_5_7": {
      "detail_density": "low_medium",
      "main_subject_count": [1, 3],
      "shape_rule": "one clear action and few props; visible emotion",
      "avoid": ["competing focal points", "complex perspective"]
    },
    "children_8_12": {
      "detail_density": "medium",
      "main_subject_count": [1, 4],
      "shape_rule": "layered environment with clear focal subject and narrative cues",
      "avoid": ["texture over focal subject", "confusing overlap"]
    },
    "teens_13_18": {
      "detail_density": "medium_high",
      "main_subject_count": [1, 5],
      "shape_rule": "more nuanced mood and realistic informative detail; clear hierarchy",
      "avoid": ["automatic childish style", "unverified generated labels"]
    },
    "adult_coloring": {
      "detail_density": "high_organized",
      "main_subject_count": [1, 3],
      "shape_rule": "radial/repeating geometry, many enclosed regions, deliberate line-weight hierarchy",
      "avoid": ["gray shading", "open gaps", "accidental solid black fills"]
    }
  },
  "global_defaults": {
    "sampler": 0,
    "steps": 28,
    "cfg": 5.3,
    "base_resolution": [768, 768],
    "hires_fix": {
      "enabled": true,
      "target_width": 1024,
      "target_height": 1024,
      "strength": [0.16, 0.3]
    },
    "comparison": {
      "fixed_seed": 31415,
      "vary_one_parameter_at_a_time": true
    }
  },
  "prompt_order": [
    "subject_and_action",
    "scene_and_composition",
    "medium_and_style",
    "lighting_and_palette",
    "craft_constraints",
    "lora_triggers"
  ],
