  "forbidRawPx": true,
  "forbidAny": true,
  "warnOnRawLayoutElements": true,
  "warnOnClassName": true,
  "requireGeneratedHeader": true,
  "globs": {
    "components": ["src/components/**/*.tsx"],
    "layouts": ["src/layouts/**/*.tsx"],
    "screens": ["src/screens/**/*.tsx"]
  }
}
